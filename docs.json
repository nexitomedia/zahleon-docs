{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Zahleon",
  "description": "Dokumentation für Zahleon – Buchhaltung, Zahlungsabgleich und Automatisierung für Shopify-Händler.",
  "colors": {
    "primary": "#312E81",
    "light": "#4F46E5",
    "dark": "#818CF8"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "pages": [
      {
        "group": "Erste Schritte",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Händlerhandbuch",
        "pages": [
          "guides/shopify",
          "guides/belege-ocr",
          "guides/rechnungen",
          "guides/zahlungen",
          "guides/provider-sammelabrechnungen",
          "guides/ustva",
          "guides/abo"
        ]
      },
      {
        "group": "Entwickler",
        "pages": [
          "developers/overview",
          "developers/security",
          "developers/webhooks"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Zahleon öffnen",
          "href": "https://app.zahleon.com",
          "icon": "arrow-up-right-from-square"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@zahleon.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Zur App",
      "href": "https://app.zahleon.com"
    }
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "Zahleon Dokumentation",
      "twitter:card": "summary"
    },
    "organization": {
      "id": "https://zahleon.com/#organization",
      "name": "Zahleon",
      "legalName": "NEXITO MEDIA LLC",
      "url": "https://zahleon.com",
      "logo": "https://developer.zahleon.com/favicon.svg",
      "sameAs": [
        "https://github.com/nexitomedia"
      ]
    }
  },
  "search": {
    "prompt": "Zahleon-Dokumentation durchsuchen …"
  },
  "metadata": {
    "timestamp": true
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/nexitomedia"
    }
  }
}
