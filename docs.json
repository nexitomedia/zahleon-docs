{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Zahleon Developers",
  "description": "Developer documentation and API reference for the Zahleon integration platform.",
  "colors": {
    "primary": "#312E81",
    "light": "#4F46E5",
    "dark": "#818CF8"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "getting-started/quickstart",
              "getting-started/authentication",
              "getting-started/conventions"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/shopify"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "webhooks/overview",
              "webhooks/shopify",
              "webhooks/stripe",
              "webhooks/paypal"
            ]
          },
          {
            "group": "Security",
            "pages": [
              "security"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "square-terminal",
        "openapi": "/openapi.json",
        "pages": [
          "reference/overview",
          {
            "group": "Invoices",
            "pages": [
              "POST /api/rechnungen",
              "PATCH /api/rechnungen/{id}",
              "DELETE /api/rechnungen/{id}",
              "POST /api/rechnungen/{id}/festschreiben"
            ]
          },
          {
            "group": "Documents",
            "pages": [
              "POST /api/belege/upload"
            ]
          },
          {
            "group": "Provider sync",
            "pages": [
              "POST /api/payment-providers/{provider}/sync",
              "POST /api/shopify/payouts/sync"
            ]
          },
          "reference/errors"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Zahleon öffnen",
          "href": "https://app.zahleon.com",
          "icon": "arrow-up-right-from-square"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/nexitomedia",
          "icon": "github"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Developer Support",
        "href": "mailto:support@zahleon.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Zahleon öffnen",
      "href": "https://app.zahleon.com"
    }
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "Zahleon Developer Documentation",
      "twitter:card": "summary"
    },
    "organization": {
      "id": "https://zahleon.com/#organization",
      "name": "Zahleon",
      "legalName": "NEXITO MEDIA LLC",
      "url": "https://zahleon.com",
      "logo": "https://developer.zahleon.com/favicon.svg",
      "sameAs": [
        "https://github.com/nexitomedia"
      ]
    }
  },
  "search": {
    "prompt": "Developer Docs durchsuchen …"
  },
  "metadata": {
    "timestamp": true
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/nexitomedia"
    }
  }
}
